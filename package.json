{
  "name": "lunaris-app",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "TZ=Europe/Warsaw node --experimental-strip-types --no-warnings --test tests/*.test.ts",
    "weather": "node --experimental-strip-types --no-warnings scripts/check-weather.ts",
    "brief": "node --experimental-strip-types --no-warnings scripts/brief.ts",
    "report": "node --experimental-strip-types --no-warnings scripts/report.ts",
    "build:places": "node --experimental-strip-types --no-warnings scripts/build-places.ts",
    "build:sky-map": "node --experimental-strip-types --no-warnings scripts/build-sky-map.ts",
    "build:horizon": "node --experimental-strip-types --no-warnings scripts/build-horizon.ts"
  },
  "dependencies": {
    "@expo-google-fonts/ibm-plex-mono": "^0.4.1",
    "@expo-google-fonts/ibm-plex-sans": "^0.4.1",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "~2.2.0",
    "@types/suncalc": "^1.9.2",
    "astronomy-engine": "^2.1.19",
    "expo": "~54.0.34",
    "expo-constants": "~18.0.13",
    "expo-file-system": "~19.0.24",
    "expo-font": "~14.0.12",
    "expo-linking": "~8.0.12",
    "expo-location": "~19.0.8",
    "expo-router": "~6.0.24",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "suncalc": "^2.0.1"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "typescript": "~5.9.2"
  },
  "private": true
}

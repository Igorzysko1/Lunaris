{
  "name": "lunaris-app",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:dev": "eas build --profile development --platform android",
    "build:apk": "eas build --profile preview --platform android",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "TZ=Europe/Warsaw node --experimental-strip-types --no-warnings --test tests/*.test.ts",
    "weather": "node --experimental-strip-types --no-warnings scripts/check-weather.ts",
    "brief": "node --experimental-strip-types --no-warnings scripts/brief.ts",
    "report": "node --experimental-strip-types --no-warnings scripts/report.ts",
    "build:places": "node --experimental-strip-types --no-warnings scripts/build-places.ts",
    "build:sky-map": "node --experimental-strip-types --no-warnings scripts/build-sky-map.ts",
    "build:horizon": "node --experimental-strip-types --no-warnings scripts/build-horizon.ts",
    "build:icons": "node --experimental-strip-types --no-warnings scripts/build-icons.ts"
  },
  "dependencies": {
    "@expo-google-fonts/ibm-plex-mono": "^0.4.1",
    "@expo-google-fonts/ibm-plex-sans": "^0.4.1",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "~2.2.0",
    "@types/suncalc": "^1.9.2",
    "astronomy-engine": "^2.1.19",
    "expo": "^57.0.21",
    "expo-constants": "~57.0.17",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.3",
    "expo-linking": "~57.0.9",
    "expo-location": "~57.0.16",
    "expo-notifications": "~57.0.17",
    "expo-router": "~57.0.20",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "suncalc": "^2.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "@types/react": "~19.2.10",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3"
  },
  "private": true
}
